{
  "opencollection": "1.0.0",
  "info": {
    "name": "Allo Analytics API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Analytics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Team metrics",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.withallo.com/v2/api/analytics/overview",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns team-wide KPIs with period-over-period comparison and a per-user breakdown. Covers all calls (inbound + outbound)."
        },
        {
          "info": {
            "name": "Outbound metrics",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.withallo.com/v2/api/analytics/outbound",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns outbound call metrics: dial funnel (dials → connected → conversations → conversions), time series, heatmap, leaderboard, and time spent metrics."
        }
      ]
    }
  ],
  "bundled": true
}