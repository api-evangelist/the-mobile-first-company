{
  "opencollection": "1.0.0",
  "info": {
    "name": "Allo Analytics Phone Numbers API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Phone Numbers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Phone Numbers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.withallo.com/v1/api/numbers",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve all Allo phone numbers associated with your account. Returns basic information about each number including country, name, and sharing status."
        },
        {
          "info": {
            "name": "List phone numbers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.withallo.com/v2/api/numbers",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns all phone numbers and sender IDs on your team."
        }
      ]
    }
  ],
  "bundled": true
}