{
  "opencollection": "1.0.0",
  "info": {
    "name": "Allo Analytics Partner API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Partner",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.withallo.com/v2/api/partner/accounts",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Creates an Allo account for one of your customers, provisions a phone number, and returns a scoped API key for the account. Requires the `PARTNER` scope. The account is billed as one seat on your subscription."
        },
        {
          "info": {
            "name": "Get account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.withallo.com/v2/api/partner/accounts/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The account id returned on create."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns the status and activation state of an account you provisioned. Requires the `PARTNER` scope."
        },
        {
          "info": {
            "name": "Deactivate account",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.withallo.com/v2/api/partner/accounts/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Deactivates an account you provisioned and releases its seat. The account stays active until the end of the current paid period, then expires. Requires the `PARTNER` scope."
        }
      ]
    }
  ],
  "bundled": true
}