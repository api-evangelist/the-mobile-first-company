  "item": [
    {
      "id": "fff4ceef-43d4-4053-ac15-bff43f7208f6",
      "name": "Calls",
      "description": {
        "content": "Retrieve and search call records with filtering and pagination. Filter calls by your Allo phone number.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "dcd77ee7-efc1-4476-858d-c83ff906e09e",
          "name": "Search Calls",
          "request": {
            "name": "Search Calls",
            "description": {
              "content": "Search and filter calls for a specific Allo phone number with pagination support.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "api",
                "calls"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "size",
                  "value": "10",
                  "description": "Number of results per page. Must be between 1 and 100."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "0",
                  "description": "Page number (0-indexed)."
                },
                {
                  "disabled": false,
                  "key": "allo_number",
                  "value": "<string>",
                  "description": "(Required) Your Allo phone number to filter calls by. Must be in E.164 format (e.g., `+1234567890`)."
                },
                {
                  "disabled": false,
                  "key": "contact_number",
                  "value": "<string>",
                  "description": "Filter calls by contact phone number. Only returns calls with this specific contact. Must be in E.164 format (e.g., `+1234567890`)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "Authorization"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
