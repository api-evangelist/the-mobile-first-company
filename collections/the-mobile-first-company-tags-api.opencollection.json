{
  "opencollection": "1.0.0",
  "info": {
    "name": "Allo Analytics Tags API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.withallo.com/v2/api/tags",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns all tags configured on the team."
        },
        {
          "info": {
            "name": "Add tags",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.withallo.com/v2/api/conversations/items/:id/tags",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Call ID (`cll-*`)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Add one or more tags to a conversation item."
        },
        {
          "info": {
            "name": "Remove tag",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.withallo.com/v2/api/conversations/items/:id/tags/:tag",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Call ID (`cll-*`)"
              },
              {
                "name": "tag",
                "value": "",
                "type": "path",
                "description": "Tag key to remove"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Remove a tag from a conversation item."
        }
      ]
    }
  ],
  "bundled": true
}