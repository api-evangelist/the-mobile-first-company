{
  "opencollection": "1.0.0",
  "info": {
    "name": "Allo Analytics Contacts API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Contacts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search Contacts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.withallo.com/v1/api/contacts",
            "params": [
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Number of results per page. Must be between 1 and 100."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (0-indexed)."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Search and filter contacts with sorting and pagination support. Returns contacts with engagement level information."
        },
        {
          "info": {
            "name": "Create Contact",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.withallo.com/v1/api/contacts",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Create a new contact in your Allo account. At least one phone number is required."
        },
        {
          "info": {
            "name": "Update Contact",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.withallo.com/v1/api/contacts/:contact_id",
            "params": [
              {
                "name": "contact_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the contact to update (e.g., \"cnt_abc123\")"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Update an existing contact. Only provided fields will be updated. Arrays (emails, numbers, addresses) replace existing values entirely."
        },
        {
          "info": {
            "name": "Get Contact",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.withallo.com/v1/api/contact/:contact_id",
            "params": [
              {
                "name": "contact_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the contact (e.g., \"cnt_abc123\")"
              },
              {
                "name": "extend",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of additional data to include. Available options: `engagement` (includes engagement level), `activity` (includes recent communication activities)."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Get detailed information for a specific contact by ID."
        }
      ]
    }
  ],
  "bundled": true
}